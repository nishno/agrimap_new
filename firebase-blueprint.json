{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uniqueId": { "type": "string" },
        "name": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "roles": { "type": "array", "items": { "type": "string" } },
        "role": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "blocked", "free", "busy"] },
        "isGuest": { "type": "boolean" },
        "isVerified": { "type": "boolean" },
        "personalNumber": { "type": "string" },
        "identificationNumber": { "type": "string" },
        "taxNumber": { "type": "string" },
        "currentOrgId": { "type": "string" },
        "subscriptionType": { "type": "string" },
        "region": { "type": "string" },
        "country": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "uniqueId", "name", "email", "roles", "status"]
    },
    "Organization": {
      "title": "Organization",
      "description": "Farm or agricultural business entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uniqueId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "taxNumber": { "type": "string" },
        "legalStructure": { "type": "string" },
        "subscriptionPlan": { "type": "string" },
        "region": { "type": "string" },
        "country": { "type": "string" },
        "areaHa": { "type": "number" },
        "location": { "type": "array", "items": { "type": "number" } },
        "isDiscoverable": { "type": "boolean" },
        "creatorId": { "type": "string" },
        "identificationNumber": { "type": "string" }
      },
      "required": ["id", "uniqueId", "name", "type", "creatorId"]
    },
    "Membership": {
      "title": "Membership",
      "description": "User membership in an organization",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "organizationId": { "type": "string" },
        "role": { "type": "string" },
        "isGlobalRegistrationAgreed": { "type": "boolean" }
      },
      "required": ["id", "userId", "organizationId", "role"]
    },
    "Project": {
      "title": "Project",
      "description": "User-created project data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "organizationId": { "type": "string" },
        "name": { "type": "string" },
        "data": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "name", "data"]
    },
    "InventoryItem": {
      "title": "Inventory Item",
      "description": "Stock item in an organization",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "organizationId": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "currentStock": { "type": "number" },
        "unitOfMeasure": { "type": "string" }
      },
      "required": ["id", "organizationId", "name", "category"]
    },
    "HarvestEvent": {
      "title": "Harvest Event",
      "description": "Harvest activity in an organization",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "organizationId": { "type": "string" },
        "name": { "type": "string" },
        "status": { "type": "string" },
        "plannedStartDate": { "type": "string" }
      },
      "required": ["id", "organizationId", "name", "status"]
    },
    "Account": {
      "title": "Account",
      "description": "Financial account in an organization",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "organizationId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "balance": { "type": "number" }
      },
      "required": ["id", "organizationId", "name", "type", "balance"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial transaction in an organization",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "organizationId": { "type": "string" },
        "date": { "type": "string" },
        "amount": { "type": "number" },
        "description": { "type": "string" }
      },
      "required": ["id", "organizationId", "date", "amount", "description"]
    },
    "SystemLog": {
      "title": "System Log",
      "description": "Activity log entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" },
        "action": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string" },
        "details": { "type": "string" },
        "organizationId": { "type": "string" }
      },
      "required": ["id", "timestamp", "userId", "action", "role", "status", "details"]
    },
    "PlantationFeature": {
      "title": "Plantation Feature",
      "description": "Map feature like a field, sector, or seedling",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "layerId": { "type": "string" },
        "organizationId": { "type": "string" },
        "condition": { "type": "string" },
        "healthStatus": { "type": "string", "enum": ["HEALTHY", "SUSPICIOUS", "DRIED"] }
      },
      "required": ["id", "name", "type", "layerId"]
    },
    "Layer": {
      "title": "Layer",
      "description": "Map layer or folder",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "isFolder": { "type": "boolean" },
        "isVisible": { "type": "boolean" },
        "parentId": { "type": "string" },
        "organizationId": { "type": "string" }
      },
      "required": ["id", "name", "isFolder", "isVisible"]
    },
    "Crop": {
      "title": "Crop",
      "description": "Agricultural crop and its varieties",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "varieties": { "type": "array", "items": { "type": "string" } },
        "organizationId": { "type": "string" }
      },
      "required": ["id", "name", "organizationId"]
    },
    "DeviceRegistry": {
      "title": "Device Registry Entry",
      "description": "Registered hardware peripheral or external Vision/Drone/GPS device",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "organizationId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["CAMERA", "DRONE", "GPS_TRACKER", "SOIL_SENSOR", "WEATHER_STATION", "PRINTER", "SCANNER", "SCALE"] },
        "name": { "type": "string", "maxLength": 160 },
        "model": { "type": "string", "maxLength": 160 },
        "connectionType": { "type": "string", "maxLength": 40 },
        "connectionInfo": { "type": "string", "maxLength": 240 },
        "ipAddress": { "type": "string", "maxLength": 64 },
        "streamUrl": { "type": "string", "maxLength": 512 },
        "rtspPort": { "type": "number" },
        "fovConfig": { "type": "object" },
        "coords": { "type": "object" },
        "status": { "type": "string", "enum": ["ONLINE", "OFFLINE", "STANDBY", "RECORDING"] },
        "lastPing": { "type": "string", "format": "date-time" },
        "sectorId": { "type": "string", "maxLength": 128 },
        "assignedWorkerId": { "type": "string", "maxLength": 128 },
        "assignedMachineryId": { "type": "string", "maxLength": 128 },
        "metadata": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "organizationId", "type", "name", "status"]
    },
    "SystemNotification": {
      "title": "System Notification",
      "description": "Alert pushed from decoupled Vision, Drone, or GPS/IoT apps into Core NotificationHub",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "organizationId": { "type": "string", "maxLength": 128 },
        "sourceApp": { "type": "string", "enum": ["vision", "drone", "gps_iot"] },
        "severity": { "type": "string", "enum": ["info", "warning", "critical"] },
        "title": { "type": "string", "maxLength": 180 },
        "message": { "type": "string", "maxLength": 1000 },
        "sectorId": { "type": "string", "maxLength": 128 },
        "deviceId": { "type": "string", "maxLength": 128 },
        "coords": { "type": "object" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "organizationId", "sourceApp", "severity", "title", "message", "isRead", "createdAt"]
    },
    "AgronomistDiagnosis": {
      "title": "Agronomist Diagnosis",
      "description": "Drone photogrammetry or AI seedling health diagnosis written for Core Agronomist review",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "organizationId": { "type": "string", "maxLength": 128 },
        "sectorId": { "type": "string", "maxLength": 128 },
        "seedlingId": { "type": "string", "maxLength": 128 },
        "droneId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 180 },
        "diagnosis": { "type": "string", "maxLength": 1500 },
        "healthStatus": { "type": "string", "enum": ["HEALTHY", "SUSPICIOUS", "DRIED"] },
        "confidence": { "type": "number" },
        "photoRef": { "type": "string", "maxLength": 512 },
        "coords": { "type": "object" },
        "recommendedAction": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "organizationId", "title", "diagnosis", "healthStatus", "createdAt"]
    },
    "LiveTelemetry": {
      "title": "Live Telemetry",
      "description": "Real-time GPS coordinates and battery status written by external GPS Hub",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "deviceId": { "type": "string", "maxLength": 128 },
        "organizationId": { "type": "string", "maxLength": 128 },
        "assetType": { "type": "string", "enum": ["worker", "machinery", "drone"] },
        "workerId": { "type": "string", "maxLength": 128 },
        "machineryId": { "type": "string", "maxLength": 128 },
        "label": { "type": "string", "maxLength": 160 },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "speed": { "type": "number" },
        "battery": { "type": "number" },
        "headingDeg": { "type": "number" },
        "sectorId": { "type": "string", "maxLength": 128 },
        "trenchId": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["deviceId", "organizationId", "assetType", "lat", "lng", "speed", "battery", "updatedAt"]
    },
    "SoilTelemetry": {
      "title": "Soil & Weather Telemetry",
      "description": "Periodic soil pH, EC, moisture, temperature, and weather readings written by GPS & IoT Hub",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "organizationId": { "type": "string", "maxLength": 128 },
        "sectorId": { "type": "string", "maxLength": 128 },
        "deviceId": { "type": "string", "maxLength": 128 },
        "soil_ph": { "type": "number" },
        "soil_ec": { "type": "number" },
        "moisture": { "type": "number" },
        "temp_c": { "type": "number" },
        "humidity_pct": { "type": "number" },
        "wind_kmh": { "type": "number" },
        "rain_mm": { "type": "number" },
        "recordedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "organizationId", "sectorId", "soil_ph", "soil_ec", "moisture", "temp_c", "recordedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/organizations/{orgId}": {
      "schema": "Organization",
      "description": "Organization documents"
    },
    "/memberships/{membershipId}": {
      "schema": "Membership",
      "description": "Membership documents"
    },
    "/plantationFeatures/{featureId}": {
      "schema": "PlantationFeature",
      "description": "Map feature documents"
    },
    "/layers/{layerId}": {
      "schema": "Layer",
      "description": "Map layer documents"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Project documents"
    },
    "/inventoryItems/{itemId}": {
      "schema": "InventoryItem",
      "description": "Inventory item documents"
    },
    "/harvestEvents/{eventId}": {
      "schema": "HarvestEvent",
      "description": "Harvest event documents"
    },
    "/accounts/{accountId}": {
      "schema": "Account",
      "description": "Financial account documents"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Financial transaction documents"
    },
    "/systemLogs/{logId}": {
      "schema": "SystemLog",
      "description": "System activity logs"
    },
    "/crops/{cropId}": {
      "schema": "Crop",
      "description": "Crop and variety definitions"
    },
    "/deviceRegistry/{docId}": {
      "schema": "DeviceRegistry",
      "description": "Hardware device registry shared between Core and external apps"
    },
    "/systemNotifications/{docId}": {
      "schema": "SystemNotification",
      "description": "External hardware alert feed listened to passively by Core NotificationHub"
    },
    "/agronomistDiagnoses/{docId}": {
      "schema": "AgronomistDiagnosis",
      "description": "Drone seedling diagnosis records reviewed in Core Agronomist tools"
    },
    "/liveTelemetry/{deviceId}": {
      "schema": "LiveTelemetry",
      "description": "Real-time GPS tracker coordinates isolated from Core bundle listeners"
    },
    "/soilTelemetry/{docId}": {
      "schema": "SoilTelemetry",
      "description": "Soil probe and weather station telemetry records"
    }
  }
}
