rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // 
    // Collection: users
    // Fields: id, name, email, roles, status, isGuest, createdAt, currentOrgId
    //
    // Collection: organizations
    // Fields: id, name, type, location, isDiscoverable, creatorId, createdBy
    //
    // Collection: memberships
    // Fields: id, userId, organizationId, role
    //
    // Collection: plantationFeatures
    // Fields: id, name, type, layerId, organizationId
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isVerified() {
      return isAuthenticated();
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == "ggwall@yandex.com" ||
          request.auth.token.email.lower() == "magrakvelidzesopio@gmail.com" ||
          request.auth.token.email.lower() == "admin@agrimap.io" ||
          request.auth.token.email.lower() == "nishno@agrimap.pro" ||
          request.auth.token.email.lower() == "giorgi.nishno@gmail.com" ||
          request.auth.token.email.lower() == "giorgi@agrimap.pro" ||
          request.auth.token.email.matches('(?i).*@agrimap\\.pro') ||
          request.auth.token.email.matches('(?i).*@agrimap\\.io')
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', []).hasAny(['Admin', 'ROOT_SUPER_ADMIN', 'founder', 'Founder']))
      );
    }

    function isMemberOf(orgId) {
      return isAuthenticated() && (
        (orgId != null && (
          exists(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + orgId)) ||
          (exists(/databases/$(database)/documents/organizations/$(orgId)) && 
           (get(/databases/$(database)/documents/organizations/$(orgId)).data.get('creatorId', '') == request.auth.uid || 
            get(/databases/$(database)/documents/organizations/$(orgId)).data.get('createdBy', '') == request.auth.uid))
        )) ||
        isAdmin()
      );
    }

    function isOrgAdmin(orgId) {
      return isAuthenticated() && (
        isAdmin() ||
        (orgId != null && (
          (exists(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + orgId)) && 
           get(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + orgId)).data.role in ['Founder', 'Admin', 'founder', 'admin', 'Founder/CEO', 'Co-Founder']) ||
          (exists(/databases/$(database)/documents/organizations/$(orgId)) && 
           (get(/databases/$(database)/documents/organizations/$(orgId)).data.get('creatorId', '') == request.auth.uid || 
            get(/databases/$(database)/documents/organizations/$(orgId)).data.get('createdBy', '') == request.auth.uid))
        ))
      );
    }

    function ownEmployee(orgId, employeeId) {
      return isAuthenticated() &&
        orgId != null &&
        employeeId != null &&
        exists(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + orgId)) &&
        get(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + orgId)).data.get('employeeId', '') == employeeId;
    }

    // Validation Helpers
    function isValidString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function isValidEmail(email) {
      return email is string && email.size() > 5;
    }

    function hasOnlyAllowedFields(allowedFields) {
      return request.resource.data.keys().hasOnly(allowedFields);
    }

    function fieldUnchanged(field) {
      return !(field in request.resource.data) || request.resource.data[field] == resource.data[field];
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidOptionalString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function isValidOptionalNumber(data, key) {
      return !(key in data) || (data[key] is number);
    }

    function isValidOptionalMap(data, key) {
      return !(key in data) || (data[key] is map);
    }

    // Domain Validators
    function isValidUser(data) {
      return true;
    }

    function isValidOrg(data) {
      return true;
    }

    function isValidDeviceRegistry(data) {
      return data.keys().hasAll(['id', 'organizationId', 'type', 'name', 'status']) &&
        data.keys().hasOnly([
          'id', 'organizationId', 'type', 'name', 'model', 'connectionType',
          'connectionInfo', 'ipAddress', 'streamUrl', 'rtspPort', 'fovConfig',
          'coords', 'status', 'lastPing', 'sectorId', 'assignedWorkerId',
          'assignedMachineryId', 'metadata', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.organizationId) &&
        data.type in ['CAMERA', 'DRONE', 'GPS_TRACKER', 'SOIL_SENSOR', 'WEATHER_STATION', 'PRINTER', 'SCANNER', 'SCALE'] &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 160 &&
        data.status in ['ONLINE', 'OFFLINE', 'STANDBY', 'RECORDING'] &&
        isValidOptionalString(data, 'model', 160) &&
        isValidOptionalString(data, 'connectionType', 40) &&
        isValidOptionalString(data, 'connectionInfo', 240) &&
        isValidOptionalString(data, 'ipAddress', 64) &&
        isValidOptionalString(data, 'streamUrl', 512) &&
        isValidOptionalNumber(data, 'rtspPort') &&
        isValidOptionalMap(data, 'fovConfig') &&
        isValidOptionalMap(data, 'coords') &&
        isValidOptionalString(data, 'lastPing', 64) &&
        isValidOptionalString(data, 'sectorId', 128) &&
        isValidOptionalString(data, 'assignedWorkerId', 128) &&
        isValidOptionalString(data, 'assignedMachineryId', 128) &&
        isValidOptionalMap(data, 'metadata') &&
        isValidOptionalString(data, 'createdAt', 64) &&
        isValidOptionalString(data, 'updatedAt', 64);
    }

    function isValidSystemNotification(data) {
      return data.keys().hasAll(['id', 'organizationId', 'sourceApp', 'severity', 'title', 'message', 'isRead', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'organizationId', 'sourceApp', 'severity', 'title', 'message',
          'sectorId', 'deviceId', 'coords', 'isRead', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.organizationId) &&
        data.sourceApp in ['vision', 'drone', 'gps_iot'] &&
        data.severity in ['info', 'warning', 'critical'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 180 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 1000 &&
        data.isRead is bool &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        isValidOptionalString(data, 'sectorId', 128) &&
        isValidOptionalString(data, 'deviceId', 128) &&
        isValidOptionalMap(data, 'coords') &&
        isValidOptionalString(data, 'updatedAt', 64);
    }

    function isValidAgronomistDiagnosis(data) {
      return data.keys().hasAll(['id', 'organizationId', 'title', 'diagnosis', 'healthStatus', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'organizationId', 'sectorId', 'seedlingId', 'droneId', 'title',
          'diagnosis', 'healthStatus', 'confidence', 'photoRef', 'coords',
          'recommendedAction', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.organizationId) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 180 &&
        data.diagnosis is string && data.diagnosis.size() >= 1 && data.diagnosis.size() <= 1500 &&
        data.healthStatus in ['HEALTHY', 'SUSPICIOUS', 'DRIED'] &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        isValidOptionalString(data, 'sectorId', 128) &&
        isValidOptionalString(data, 'seedlingId', 128) &&
        isValidOptionalString(data, 'droneId', 128) &&
        isValidOptionalNumber(data, 'confidence') &&
        isValidOptionalString(data, 'photoRef', 512) &&
        isValidOptionalMap(data, 'coords') &&
        isValidOptionalString(data, 'recommendedAction', 500) &&
        isValidOptionalString(data, 'updatedAt', 64);
    }

    function isValidLiveTelemetry(data) {
      return data.keys().hasAll(['deviceId', 'organizationId', 'assetType', 'lat', 'lng', 'speed', 'battery', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'deviceId', 'organizationId', 'assetType', 'workerId',
          'machineryId', 'label', 'lat', 'lng', 'speed', 'battery',
          'headingDeg', 'sectorId', 'trenchId', 'updatedAt'
        ]) &&
        isValidId(data.deviceId) &&
        isValidId(data.organizationId) &&
        data.assetType in ['worker', 'machinery', 'drone'] &&
        data.lat is number &&
        data.lng is number &&
        data.speed is number &&
        data.battery is number &&
        data.updatedAt is string && data.updatedAt.size() <= 64 &&
        isValidOptionalString(data, 'id', 128) &&
        isValidOptionalString(data, 'workerId', 128) &&
        isValidOptionalString(data, 'machineryId', 128) &&
        isValidOptionalString(data, 'label', 160) &&
        isValidOptionalNumber(data, 'headingDeg') &&
        isValidOptionalString(data, 'sectorId', 128) &&
        isValidOptionalString(data, 'trenchId', 128);
    }

    function isValidSoilTelemetry(data) {
      return data.keys().hasAll(['id', 'organizationId', 'sectorId', 'soil_ph', 'soil_ec', 'moisture', 'temp_c', 'recordedAt']) &&
        data.keys().hasOnly([
          'id', 'organizationId', 'sectorId', 'deviceId', 'soil_ph', 'soil_ec',
          'moisture', 'temp_c', 'humidity_pct', 'wind_kmh', 'rain_mm',
          'recordedAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.organizationId) &&
        isValidId(data.sectorId) &&
        data.soil_ph is number &&
        data.soil_ec is number &&
        data.moisture is number &&
        data.temp_c is number &&
        data.recordedAt is string && data.recordedAt.size() <= 64 &&
        isValidOptionalString(data, 'deviceId', 128) &&
        isValidOptionalNumber(data, 'humidity_pct') &&
        isValidOptionalNumber(data, 'wind_kmh') &&
        isValidOptionalNumber(data, 'rain_mm') &&
        isValidOptionalString(data, 'updatedAt', 64);
    }

    function isValidJoinRequest(data) {
      return data.keys().hasAll(['id', 'userId', 'userName', 'organizationId', 'status', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'userId', 'userName', 'userEmail', 'organizationId', 'organizationName',
          'requestedRole', 'message', 'status', 'createdAt', 'reviewedAt', 'reviewedBy'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 256 &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 160 &&
        data.organizationId is string && data.organizationId.size() >= 1 && data.organizationId.size() <= 128 &&
        data.status in ['pending', 'approved', 'declined'] &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        isValidOptionalString(data, 'userEmail', 180) &&
        isValidOptionalString(data, 'organizationName', 180) &&
        isValidOptionalString(data, 'requestedRole', 80) &&
        isValidOptionalString(data, 'message', 1000) &&
        isValidOptionalString(data, 'reviewedAt', 64) &&
        isValidOptionalString(data, 'reviewedBy', 128);
    }

    function isValidClinicalRecord(data) {
      return data.keys().hasAll(['id', 'type', 'title', 'createdAt', 'organizationId']) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'sourceCategory', 'updatedAt', 'plan', 'type', 'title',
          'createdAt', 'organizationId', 'imageDataUrl', 'fileNames', 'rawAiResult',
          'agronomistConclusion', 'aiLearnedInsights', 'peerComparison', 'migrationSource',
          'isDeleted'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 160 &&
        data.type in ['disease', 'document', 'agro_image', 'soil'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 240 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.organizationId is string && data.organizationId.size() <= 128 &&
        isValidOptionalString(data, 'ownerId', 128) &&
        (!( 'sourceCategory' in data ) || data.sourceCategory in ['AI-generated', 'Agronomist-created', 'Combined']) &&
        isValidOptionalString(data, 'updatedAt', 64) &&
        isValidOptionalMap(data, 'plan') &&
        isValidOptionalMap(data, 'agronomistConclusion') &&
        isValidOptionalMap(data, 'peerComparison') &&
        isValidOptionalString(data, 'migrationSource', 40) &&
        (!( 'isDeleted' in data ) || data.isDeleted is bool);
    }

    function isValidWorkerActivity(data) {
      return data.keys().hasAll(['id', 'organizationId', 'employeeId', 'kind', 'date']) &&
        data.keys().hasOnly([
          'id', 'organizationId', 'employeeId', 'userId', 'kind', 'title', 'date',
          'hours', 'kg', 'amount', 'currency', 'status', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 160 &&
        data.organizationId is string && data.organizationId.size() >= 1 && data.organizationId.size() <= 128 &&
        data.employeeId is string && data.employeeId.size() >= 1 && data.employeeId.size() <= 160 &&
        data.kind is string && data.kind.size() >= 1 && data.kind.size() <= 40 &&
        data.date is string && data.date.size() <= 64 &&
        isValidOptionalString(data, 'userId', 128) &&
        isValidOptionalString(data, 'title', 200) &&
        isValidOptionalNumber(data, 'hours') &&
        isValidOptionalNumber(data, 'kg') &&
        isValidOptionalNumber(data, 'amount') &&
        isValidOptionalString(data, 'currency', 16) &&
        isValidOptionalString(data, 'status', 40) &&
        isValidOptionalString(data, 'updatedAt', 64);
    }

    function isValidPartnerProfile(data) {
      return data.keys().hasAll(['id', 'userId']) &&
        data.keys().hasOnly([
          'id', 'userId', 'name', 'region', 'services', 'bio', 'phone', 'email',
          'availability', 'updatedAt', 'createdAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        isValidOptionalString(data, 'name', 160) &&
        isValidOptionalString(data, 'region', 120) &&
        isValidOptionalString(data, 'bio', 2000) &&
        isValidOptionalString(data, 'phone', 64) &&
        isValidOptionalString(data, 'email', 180) &&
        isValidOptionalString(data, 'availability', 64) &&
        isValidOptionalString(data, 'updatedAt', 64) &&
        isValidOptionalString(data, 'createdAt', 64);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /test/connection {
      allow get: if true;
    }

    match /_connection_test_/{id} {
      allow read: if true;
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || 
        isAdmin() || 
        (resource != null && request.auth.token.email == resource.data.get('email', '')) ||
        (resource != null && resource.data.get('status', '') == 'active')
      );
      allow create: if isAuthenticated() && (request.auth.uid == userId || isAdmin()) && 
                    isValidUser(request.resource.data) &&
                    (request.resource.data.get('roles', []) == [] || 
                     request.resource.data.get('roles', []) == ['User'] || 
                     request.resource.data.get('roles', []) == ['Guest'] || 
                     request.resource.data.get('roles', []) == ['worker'] || 
                     request.resource.data.get('roles', []).hasAll(['Guest']) ||
                     request.resource.data.get('roles', []).hasAll(['worker'])); 
      allow update: if isAuthenticated() && (
                      (isOwner(userId) && isValidUser(request.resource.data) && 
                       (fieldUnchanged('roles') || 
                        (!request.resource.data.get('roles', []).hasAny(['Admin', 'ROOT_SUPER_ADMIN']) && 
                         (resource.data.get('roles', []) == ['Guest'] || 
                          request.resource.data.get('roles', []).hasAll(resource.data.get('roles', []).removeAll(['Guest']))
                         )
                        )
                       )
                      ) || 
                      isAdmin()
                    );
      allow delete: if isAdmin();
    }

    match /organizations/{orgId} {
      allow list, get: if true;
      allow create: if isAuthenticated() && 
                    (request.resource.data.get('creatorId', '') == request.auth.uid || request.resource.data.get('createdBy', '') == request.auth.uid) &&
                    isValidOrg(request.resource.data);
      allow update: if isAdmin() || (isAuthenticated() && isOrgAdmin(orgId) && isValidOrg(request.resource.data));
      allow delete: if isAdmin();
    }

    match /memberships/{membershipId} {
      allow list: if isAuthenticated();
      allow get: if isAuthenticated() && (resource.data.userId == request.auth.uid || isMemberOf(resource.data.organizationId) || isAdmin());
      allow create: if isAuthenticated() && (
        isAdmin() || 
        isOrgAdmin(request.resource.data.organizationId) ||
        (request.resource.data.userId == request.auth.uid)
      );
      allow update: if isAdmin() || (isAuthenticated() && isOrgAdmin(resource.data.organizationId));
      allow delete: if isAdmin() || (isAuthenticated() && (isOrgAdmin(resource.data.organizationId) || resource.data.userId == request.auth.uid));
    }

    match /projects/{projectId} {
      allow list: if isAuthenticated();
      allow get: if isAuthenticated() && (resource.data.userId == request.auth.uid || isMemberOf(resource.data.organizationId) || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /{collection}/{docId} {
      allow list: if isAuthenticated() && 
        !(collection in ['alerts', 'cropVarieties', 'listings', 'bids', 'reviews', 'forumPosts', 'deviceRegistry', 'systemNotifications', 'agronomistDiagnoses', 'liveTelemetry', 'soilTelemetry', 'joinRequests', 'clinicalRecords', 'workerActivities', 'partnerProfiles']) && (
        isAdmin() || 
        (resource != null && (isMemberOf(resource.data.get('organizationId', null)) || resource.data.get('createdBy', '') == request.auth.uid))
      );
      allow get: if isAuthenticated() && 
        !(collection in ['alerts', 'cropVarieties', 'listings', 'bids', 'reviews', 'forumPosts', 'deviceRegistry', 'systemNotifications', 'agronomistDiagnoses', 'liveTelemetry', 'soilTelemetry', 'joinRequests', 'clinicalRecords', 'workerActivities', 'partnerProfiles']) && (
        isAdmin() ||
        resource == null || 
        isMemberOf(resource.data.get('organizationId', null)) ||
        resource.data.get('createdBy', '') == request.auth.uid
      );
      allow create: if isAuthenticated() && 
        !(collection in ['alerts', 'cropVarieties', 'listings', 'bids', 'reviews', 'forumPosts', 'deviceRegistry', 'systemNotifications', 'agronomistDiagnoses', 'liveTelemetry', 'soilTelemetry', 'joinRequests', 'clinicalRecords', 'workerActivities', 'partnerProfiles']) && (
        isAdmin() ||
        isMemberOf(request.resource.data.get('organizationId', null)) ||
        request.resource.data.get('createdBy', '') == request.auth.uid
      );
      allow update: if isAuthenticated() && 
        !(collection in ['alerts', 'cropVarieties', 'listings', 'bids', 'reviews', 'forumPosts', 'deviceRegistry', 'systemNotifications', 'agronomistDiagnoses', 'liveTelemetry', 'soilTelemetry', 'joinRequests', 'clinicalRecords', 'workerActivities', 'partnerProfiles']) && (
        isAdmin() ||
        isMemberOf(resource.data.get('organizationId', null)) ||
        resource.data.get('createdBy', '') == request.auth.uid
      );
      allow delete: if isAuthenticated() && 
        !(collection in ['alerts', 'cropVarieties', 'listings', 'bids', 'reviews', 'forumPosts', 'deviceRegistry', 'systemNotifications', 'agronomistDiagnoses', 'liveTelemetry', 'soilTelemetry', 'joinRequests', 'clinicalRecords', 'workerActivities', 'partnerProfiles']) && (
        isAdmin() ||
        isOrgAdmin(resource.data.get('organizationId', null)) ||
        resource.data.get('createdBy', '') == request.auth.uid
      );
    }

    // Explicitly handle collections that were in the previous rules to ensure no regression
    match /plantationFeatures/{id} {
      allow read, write: if isAuthenticated() && (
        isAdmin() ||
        (resource == null || isMemberOf(resource.data.get('organizationId', null)) || resource.data.get('createdBy', '') == request.auth.uid) &&
        (request.resource == null || isMemberOf(request.resource.data.get('organizationId', null)) || request.resource.data.get('createdBy', '') == request.auth.uid)
      );
    }
    
    match /layers/{id} {
      allow read, write: if isVerified() && (
        (resource == null || isMemberOf(resource.data.get('organizationId', ''))) &&
        (request.resource == null || isMemberOf(request.resource.data.get('organizationId', '')))
      );
    }

    match /inventoryItems/{id} {
      allow read, write: if isVerified() && (
        (resource == null || isMemberOf(resource.data.get('organizationId', ''))) &&
        (request.resource == null || isMemberOf(request.resource.data.get('organizationId', '')))
      );
    }

    match /harvestEvents/{id} {
      allow read, write: if isVerified() && (
        (resource == null || isMemberOf(resource.data.get('organizationId', ''))) &&
        (request.resource == null || isMemberOf(request.resource.data.get('organizationId', '')))
      );
    }

    match /accounts/{id} {
      allow read, write: if isVerified() && (
        (resource == null || isMemberOf(resource.data.get('organizationId', ''))) &&
        (request.resource == null || isMemberOf(request.resource.data.get('organizationId', '')))
      );
    }

    match /transactions/{id} {
      allow read, write: if isVerified() && (
        (resource == null || isMemberOf(resource.data.get('organizationId', ''))) &&
        (request.resource == null || isMemberOf(request.resource.data.get('organizationId', '')))
      );
    }

    match /workAssignments/{id} {
      allow read, write: if isVerified() && (
        (resource == null || isMemberOf(resource.data.get('organizationId', ''))) &&
        (request.resource == null || isMemberOf(request.resource.data.get('organizationId', '')))
      );
    }

    match /employees/{id} {
      allow read, write: if isVerified() && (
        id.startsWith('emp-' + request.auth.uid) ||
        (request.resource != null && request.resource.data.get('email', '') == request.auth.token.email) ||
        (resource != null && resource.data.get('email', '') == request.auth.token.email) ||
        (
          (resource == null || isMemberOf(resource.data.get('organizationId', ''))) &&
          (request.resource == null || isMemberOf(request.resource.data.get('organizationId', '')))
        )
      );
    }

    match /machinery/{id} {
      allow read, write: if isVerified() && (
        (resource == null || isMemberOf(resource.data.get('organizationId', ''))) &&
        (request.resource == null || isMemberOf(request.resource.data.get('organizationId', '')))
      );
    }

    match /nutritionPlans/{id} {
      allow read, write: if isVerified() && (
        (resource == null || isMemberOf(resource.data.get('organizationId', ''))) &&
        (request.resource == null || isMemberOf(request.resource.data.get('organizationId', '')))
      );
    }

    match /planExecutions/{id} {
      allow read, write: if isVerified() && (
        (resource == null || isMemberOf(resource.data.get('organizationId', ''))) &&
        (request.resource == null || isMemberOf(request.resource.data.get('organizationId', '')))
      );
    }

    match /dailyLogs/{id} {
      allow read, write: if isVerified() && (
        (resource == null || isMemberOf(resource.data.get('organizationId', ''))) &&
        (request.resource == null || isMemberOf(request.resource.data.get('organizationId', '')))
      );
    }

    match /employeeGroups/{id} {
      allow read, write: if isVerified() && (
        (resource == null || isMemberOf(resource.data.get('organizationId', ''))) &&
        (request.resource == null || isMemberOf(request.resource.data.get('organizationId', '')))
      );
    }

    match /forumPosts/{id} {
      allow read, write: if isAuthenticated(); // Posts can be made by anyone authenticated for now? Or verified? Let's use isVerified for writes.
      allow write: if isVerified();
      allow get: if isAuthenticated();
    }

    match /listings/{id} {
      allow read: if isAuthenticated();
      allow write: if isVerified();
    }

    match /bids/{id} {
      allow read: if isAuthenticated();
      allow write: if isVerified();
    }

    match /reviews/{id} {
      allow read: if isAuthenticated();
      allow write: if isVerified();
    }

    match /alerts/{id} {
      allow read: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow read: if isAuthenticated() && resource.data.get('recipientId', '') == request.auth.uid;
      allow read: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
      allow read: if isAuthenticated() && resource.data.get('createdBy', '') == request.auth.uid;
      allow read: if isAuthenticated() && isMemberOf(resource.data.get('organizationId', ''));
      allow write: if isAuthenticated() && (
        (resource == null || isMemberOf(resource.data.get('organizationId', '')) || resource.data.get('recipientId', '') == request.auth.uid || resource.data.get('createdBy', '') == request.auth.uid) &&
        (request.resource == null || isMemberOf(request.resource.data.get('organizationId', '')) || request.resource.data.get('recipientId', '') == request.auth.uid || request.resource.data.get('createdBy', '') == request.auth.uid)
      );
    }

    match /cropVarieties/{id} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /harvestEntries/{id} {
      allow read, write: if isVerified() && (
        (resource == null || isMemberOf(resource.data.get('organizationId', ''))) &&
        (request.resource == null || isMemberOf(request.resource.data.get('organizationId', '')))
      );
    }

    match /pallets/{id} {
      allow read, write: if isVerified() && (
        (resource == null || isMemberOf(resource.data.get('organizationId', ''))) &&
        (request.resource == null || isMemberOf(request.resource.data.get('organizationId', '')))
      );
    }

    match /harvestLogs/{id} {
      allow read, write: if isVerified() && (
        (resource == null || isMemberOf(resource.data.get('organizationId', ''))) &&
        (request.resource == null || isMemberOf(request.resource.data.get('organizationId', '')))
      );
    }

    match /inventoryTransactions/{id} {
      allow read, write: if isVerified() && (
        (resource == null || isMemberOf(resource.data.get('organizationId', ''))) &&
        (request.resource == null || isMemberOf(request.resource.data.get('organizationId', '')))
      );
    }

    match /suppliers/{id} {
      allow read, write: if isVerified() && (
        (resource == null || isMemberOf(resource.data.get('organizationId', ''))) &&
        (request.resource == null || isMemberOf(request.resource.data.get('organizationId', '')))
      );
    }

    match /purchaseOrders/{id} {
      allow read, write: if isVerified() && (
        (resource == null || isMemberOf(resource.data.get('organizationId', ''))) &&
        (request.resource == null || isMemberOf(request.resource.data.get('organizationId', '')))
      );
    }

    match /notes/{id} {
      allow read, write: if isVerified() && (
        (resource == null || isMemberOf(resource.data.get('organizationId', ''))) &&
        (request.resource == null || isMemberOf(request.resource.data.get('organizationId', '')))
      );
    }

    match /checkpoints/{id} {
      allow read, write: if isVerified() && (
        (resource == null || isMemberOf(resource.data.get('organizationId', ''))) &&
        (request.resource == null || isMemberOf(request.resource.data.get('organizationId', '')))
      );
    }

    match /crops/{id} {
      allow read, write: if isVerified() && (
        (resource == null || isMemberOf(resource.data.get('organizationId', ''))) &&
        (request.resource == null || isMemberOf(request.resource.data.get('organizationId', '')))
      );
    }

    match /systemLogs/{id} {
      allow list: if isAdmin();
      allow get: if isAdmin() || (isAuthenticated() && resource.data.organizationId != null && isMemberOf(resource.data.organizationId));
      allow write: if isAuthenticated();
    }

    match /systemSettings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /unique_identifiers/{id} {
      allow get: if true;
      allow create: if isAuthenticated();
    }

    // ===============================================================
    // Decoupled External Hardware Contract Collections (Tenant-Fenced)
    // ===============================================================

    match /deviceRegistry/{docId} {
      allow get: if isAuthenticated() && isValidId(docId) && (
        isAdmin() ||
        (resource != null && isMemberOf(existing().organizationId))
      );
      allow list: if isAuthenticated() && (
        isAdmin() ||
        isMemberOf(existing().organizationId)
      );
      allow create: if isAuthenticated() && isValidId(docId) &&
        isValidDeviceRegistry(incoming()) &&
        (isAdmin() || isMemberOf(incoming().organizationId));
      allow update: if isAuthenticated() && isValidId(docId) &&
        isValidDeviceRegistry(incoming()) &&
        incoming().organizationId == existing().organizationId &&
        incoming().id == existing().id && (
          isAdmin() ||
          (isOrgAdmin(existing().organizationId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'model', 'connectionType', 'connectionInfo', 'ipAddress',
              'streamUrl', 'rtspPort', 'fovConfig', 'coords', 'status', 'lastPing',
              'sectorId', 'assignedWorkerId', 'assignedMachineryId', 'metadata',
              'updatedAt', 'type'
            ])) ||
          (isMemberOf(existing().organizationId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'lastPing', 'coords', 'fovConfig', 'streamUrl',
              'ipAddress', 'rtspPort', 'model', 'name', 'connectionType',
              'type', 'updatedAt'
            ]))
        );
      allow delete: if isAuthenticated() && isValidId(docId) && (
        isAdmin() ||
        isOrgAdmin(existing().organizationId)
      );
    }

    match /systemNotifications/{docId} {
      allow get: if isAuthenticated() && isValidId(docId) && (
        isAdmin() ||
        (resource != null && isMemberOf(existing().organizationId))
      );
      allow list: if isAuthenticated() && (
        isAdmin() ||
        isMemberOf(existing().organizationId)
      );
      allow create: if isAuthenticated() && isValidId(docId) &&
        isValidSystemNotification(incoming()) &&
        (isAdmin() || isMemberOf(incoming().organizationId));
      allow update: if isAuthenticated() && isValidId(docId) &&
        isValidSystemNotification(incoming()) &&
        incoming().organizationId == existing().organizationId &&
        incoming().id == existing().id && (
          isAdmin() ||
          (isMemberOf(existing().organizationId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'updatedAt']))
        );
      allow delete: if isAuthenticated() && isValidId(docId) && (
        isAdmin() ||
        isOrgAdmin(existing().organizationId)
      );
    }

    match /agronomistDiagnoses/{docId} {
      allow get: if isAuthenticated() && isValidId(docId) && (
        isAdmin() ||
        (resource != null && isMemberOf(existing().organizationId))
      );
      allow list: if isAuthenticated() && (
        isAdmin() ||
        isMemberOf(existing().organizationId)
      );
      allow create: if isAuthenticated() && isValidId(docId) &&
        isValidAgronomistDiagnosis(incoming()) &&
        (isAdmin() || isMemberOf(incoming().organizationId));
      allow update: if isAuthenticated() && isValidId(docId) &&
        isValidAgronomistDiagnosis(incoming()) &&
        incoming().organizationId == existing().organizationId &&
        incoming().id == existing().id && (
          isAdmin() ||
          (isMemberOf(existing().organizationId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'healthStatus', 'diagnosis', 'recommendedAction', 'confidence',
              'photoRef', 'coords', 'updatedAt'
            ]))
        );
      allow delete: if isAuthenticated() && isValidId(docId) && (
        isAdmin() ||
        isOrgAdmin(existing().organizationId)
      );
    }

    match /liveTelemetry/{deviceId} {
      allow get: if isAuthenticated() && isValidId(deviceId) && (
        isAdmin() ||
        (resource != null && isMemberOf(existing().organizationId))
      );
      allow list: if isAuthenticated() && (
        isAdmin() ||
        isMemberOf(existing().organizationId)
      );
      allow create: if isAuthenticated() && isValidId(deviceId) &&
        isValidLiveTelemetry(incoming()) &&
        (isAdmin() || isMemberOf(incoming().organizationId));
      allow update: if isAuthenticated() && isValidId(deviceId) &&
        isValidLiveTelemetry(incoming()) &&
        incoming().organizationId == existing().organizationId &&
        incoming().deviceId == existing().deviceId && (
          isAdmin() ||
          (isMemberOf(existing().organizationId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'id', 'lat', 'lng', 'speed', 'battery', 'headingDeg', 'sectorId',
              'trenchId', 'label', 'workerId', 'machineryId', 'assetType', 'updatedAt'
            ]))
        );
      allow delete: if isAuthenticated() && isValidId(deviceId) && (
        isAdmin() ||
        isOrgAdmin(existing().organizationId)
      );
    }

    match /soilTelemetry/{docId} {
      allow get: if isAuthenticated() && isValidId(docId) && (
        isAdmin() ||
        (resource != null && isMemberOf(existing().organizationId))
      );
      allow list: if isAuthenticated() && (
        isAdmin() ||
        isMemberOf(existing().organizationId)
      );
      allow create: if isAuthenticated() && isValidId(docId) &&
        isValidSoilTelemetry(incoming()) &&
        (isAdmin() || isMemberOf(incoming().organizationId));
      allow update: if isAuthenticated() && isValidId(docId) &&
        isValidSoilTelemetry(incoming()) &&
        incoming().organizationId == existing().organizationId &&
        incoming().id == existing().id &&
        incoming().sectorId == existing().sectorId && (
          isAdmin() ||
          (isMemberOf(existing().organizationId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'deviceId', 'soil_ph', 'soil_ec', 'moisture', 'temp_c',
              'humidity_pct', 'wind_kmh', 'rain_mm', 'recordedAt', 'updatedAt'
            ]))
        );
      allow delete: if isAuthenticated() && isValidId(docId) && (
        isAdmin() ||
        isOrgAdmin(existing().organizationId)
      );
    }

    // ===============================================================
    // Role-Scoped Join Requests, Clinical Archive & Worker Collections
    // ===============================================================

    match /joinRequests/{requestId} {
      allow get: if isAuthenticated() && (
        isAdmin() ||
        (resource != null && (
          existing().userId == request.auth.uid ||
          isOrgAdmin(existing().organizationId)
        ))
      );
      allow list: if isAuthenticated() && (
        isAdmin() ||
        existing().userId == request.auth.uid ||
        isOrgAdmin(existing().organizationId)
      );
      allow create: if isAuthenticated() &&
        isValidJoinRequest(incoming()) &&
        requestId == request.auth.uid + '_' + incoming().organizationId &&
        incoming().id == requestId &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'pending';
      allow update: if isAuthenticated() && isValidJoinRequest(incoming()) && (
        isAdmin() ||
        (isOrgAdmin(existing().organizationId) &&
          incoming().userId == existing().userId &&
          incoming().organizationId == existing().organizationId &&
          incoming().status in ['approved', 'declined']) ||
        (existing().userId == request.auth.uid &&
          existing().status == 'declined' &&
          incoming().userId == existing().userId &&
          incoming().organizationId == existing().organizationId &&
          incoming().status == 'pending')
      );
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        existing().userId == request.auth.uid ||
        isOrgAdmin(existing().organizationId)
      );
    }

    match /clinicalRecords/{recordId} {
      allow get: if isAuthenticated() && (
        isAdmin() ||
        resource == null ||
        existing().get('ownerId', '') == request.auth.uid ||
        (existing().get('organizationId', '') != '' && isMemberOf(existing().organizationId))
      );
      allow list: if isAuthenticated() && (
        isAdmin() ||
        existing().get('ownerId', '') == request.auth.uid ||
        (existing().get('organizationId', '') != '' && isMemberOf(existing().organizationId))
      );
      allow create: if isAuthenticated() &&
        isValidClinicalRecord(incoming()) &&
        incoming().id == recordId &&
        (
          isAdmin() ||
          (incoming().get('organizationId', '') == '' && incoming().get('ownerId', '') == request.auth.uid) ||
          (incoming().get('organizationId', '') != '' && isMemberOf(incoming().organizationId) &&
            (incoming().get('ownerId', '') == '' || incoming().get('ownerId', '') == request.auth.uid))
        );
      allow update: if isAuthenticated() &&
        isValidClinicalRecord(incoming()) &&
        incoming().id == existing().id &&
        incoming().organizationId == existing().organizationId && (
          isAdmin() ||
          existing().get('ownerId', '') == request.auth.uid ||
          (existing().get('organizationId', '') != '' && isMemberOf(existing().organizationId))
        );
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        existing().get('ownerId', '') == request.auth.uid ||
        (existing().get('organizationId', '') != '' && isOrgAdmin(existing().organizationId))
      );
    }

    match /workerActivities/{activityId} {
      allow get: if isAuthenticated() && (
        isAdmin() ||
        (resource != null && (
          isOrgAdmin(existing().organizationId) ||
          existing().get('userId', '') == request.auth.uid ||
          ownEmployee(existing().organizationId, existing().employeeId)
        ))
      );
      allow list: if isAuthenticated() && (
        isAdmin() ||
        isOrgAdmin(existing().organizationId) ||
        existing().get('userId', '') == request.auth.uid ||
        ownEmployee(existing().organizationId, existing().employeeId)
      );
      allow create, update: if isAuthenticated() &&
        isValidWorkerActivity(incoming()) &&
        (isAdmin() || isOrgAdmin(incoming().organizationId));
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        isOrgAdmin(existing().organizationId)
      );
    }

    match /partnerProfiles/{profileId} {
      allow get, list: if isAuthenticated();
      allow create: if isAuthenticated() &&
        isValidPartnerProfile(incoming()) &&
        (isAdmin() || incoming().userId == request.auth.uid);
      allow update: if isAuthenticated() &&
        isValidPartnerProfile(incoming()) &&
        incoming().userId == existing().userId &&
        (isAdmin() || existing().userId == request.auth.uid);
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        existing().userId == request.auth.uid
      );
    }
  }
}
